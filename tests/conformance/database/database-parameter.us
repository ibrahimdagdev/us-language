model Kullanıcı
{
    id: tamsayı : anahtar
    ad: metin
    aktif: mantıksal
}
veritabanı UygulamaDb
{
    tablo kullanıcılar: Kullanıcı
}
bağla db: UygulamaDb
bekle db.kullanıcılar.ekle(@Kullanıcı { ad = "Ali' OR 1=1" aktif = doğru })
aranan: metin = "Ali' OR 1=1"
satırlar: liste<Kullanıcı> = bekle db.kullanıcılar.filtrele(^.ad == aranan).tümü()
syaz "{satırlar.adet}"
