sınıf Kutu
{
    genel olay değişti: metin
    genel fonksiyon bir(değer: metin)
    {
        syaz "1"
    }
    genel fonksiyon iki(değer: metin)
    {
        syaz "2"
    }
}
kutu: Kutu = @Kutu()
kutu.değişti += kutu.bir
kutu.değişti += kutu.iki
kutu.değişti -= kutu.bir
kutu.değişti.tetikle("a")
